"><mxPoint x="492.1" y="193"/></Array></mxGeometry></mxCell><mxCell id="c_e_edge1" value="tagihan lunas" style="edgeStyle=none;curved=1;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;startArrow=none;" edge="1" parent="1" source="c_menunggu_bayar" target="c_aktif"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="411.1" y="322"/></Array></mxGeometry></mxCell><mxCell id="c_e_edge2" value="tagihan void / pesanan dibatalkan" style="edgeStyle=none;curved=1;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;startArrow=none;" edge="1" parent="1" source="c_menunggu_bayar" target="c_dibatalkan"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="573.1" y="322"/></Array></mxGeometry></mxCell><mxCell id="c_e_edge3" value="refund tagihan atau refund sisa prorata" style="edgeStyle=none;curved=1;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;startArrow=none;" edge="1" parent="1" source="c_aktif" target="c_direfund"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="148" y="451"/></Array></mxGeometry></mxCell><mxCell id="c_e_edge4" value="alihkan ke pasien lain" style="edgeStyle=none;curved=1;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;startArrow=none;" edge="1" parent="1" source="c_aktif" target="c_dialihkan"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="335.3" y="451"/></Array></mxGeometry></mxCell><mxCell id="c_e_edge5" value="sisa sesi 0 (dihitung)" style="edgeStyle=none;curved=1;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;startArrow=none;" edge="1" parent="1" source="c_aktif" target="c_habis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="486.9" y="451"/></Array></mxGeometry></mxCell><mxCell id="c_e_edge6" value="lewat berlaku_sampai (dihitung)" style="edgeStyle=none;curved=1;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;startArrow=none;" edge="1" parent="1" source="c_aktif" target="c_kedaluwarsa"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="671.3" y="451"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="hal-status-lainnya" name="09 Rencana gigi, komisi, persetujuan"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="690" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="judul" value="&lt;font style=&quot;font-size:10px;letter-spacing:1px&quot;&gt;RENCANA · KOMISI · PERSETUJUAN&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:20px&quot;&gt;Rencana gigi, komisi, persetujuan&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#000000;strokeColor=none;fillColor=none;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="32" width="820" height="44" as="geometry"/></mxCell><mxCell id="catatan" value="• Rencana perawatan: saat disetujui pasien, estimasi biaya dikunci; perubahan lewat revisi (kembali ke &lt;font face=&quot;Courier New&quot;&gt;draf&lt;/font&gt;).&lt;br&gt;• Periode komisi: hitung ulang dan penyesuaian hanya selama &lt;font face=&quot;Courier New&quot;&gt;draf&lt;/font&gt;; setelah disetujui terkunci.&lt;br&gt;• Informed consent bernilai &lt;font face=&quot;Courier New&quot;&gt;disetujui&lt;/font&gt; atau &lt;font face=&quot;Courier New&quot;&gt;ditolak&lt;/font&gt; saat ditandatangani, lalu bisa &lt;font face=&quot;Courier New&quot;&gt;dicabut&lt;/font&gt;. Consent, persetujuan, dan addendum tidak pernah dihapus." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#000000;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="820" height="61" as="geometry"/></mxCell><mxCell id="c_RencanaPerawatan" value="Rencana perawatan gigi" style="swimlane;rounded=1;arcSize=4;startSize=28;html=1;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;container=1;collapsible=0;startSize=23;" vertex="1" parent="1"><mxGeometry x="48" y="167" width="308.3" height="467" as="geometry"/></mxCell><mxCell id="c_KomisiPeriode" value="Periode komisi" style="swimlane;rounded=1;arcSize=4;startSize=28;html=1;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;container=1;collapsible=0;startSize=23;" vertex="1" parent="1"><mxGeometry x="406.3" y="223" width="152.4" height="355" as="geometry"/></mxCell><mxCell id="c_Persetujuan" value="Persetujuan data &amp;amp; foto" style="swimlane;rounded=1;arcSize=4;startSize=28;html=1;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;container=1;collapsible=0;startSize=23;" vertex="1" parent="1"><mxGeometry x="608.7" y="223" width="243.2" height="355" as="geometry"/></mxCell><mxCell id="c_RencanaPerawatan_start" value="" style="ellipse;aspect=fixed;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="c_RencanaPerawatan"><mxGeometry x="183.6" y="37.5" width="14" height="14" as="geometry"/></mxCell><mxCell id="c_draf" value="draf" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c_RencanaPerawatan"><mxGeometry x="170" y="126.5" width="41.2" height="37" as="geometry"/></mxCell><mxCell id="c_disetujui" value="disetujui" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;