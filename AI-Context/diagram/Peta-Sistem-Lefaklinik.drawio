ed=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;startArrow=none;" edge="1" parent="1" source="c_SVC" target="c_FS"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1733.3" y="437.4"/></Array></mxGeometry></mxCell><mxCell id="c_e_L_SVC_Q_0" value="dispatch job" style="edgeStyle=none;curved=1;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;startArrow=none;" edge="1" parent="1" source="c_SVC" target="c_Q"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1733.3" y="478.4"/></Array></mxGeometry></mxCell><mxCell id="c_e_L_SCH_Q_0" value="wa-jadwal tiap 10 menit,&lt;br&gt;prune token &amp;amp; job gagal" style="edgeStyle=none;curved=1;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;startArrow=none;" edge="1" parent="1" source="c_SCH" target="c_Q"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1733.3" y="571.9"/></Array></mxGeometry></mxCell><mxCell id="c_e_L_Q_SS_0" value="" style="edgeStyle=none;curved=1;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;startArrow=none;" edge="1" parent="1" source="c_Q" target="c_SS"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2226.3" y="550.4"/></Array></mxGeometry></mxCell><mxCell id="c_e_L_Q_WA_0" value="" style="edgeStyle=none;curved=1;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;startArrow=none;" edge="1" parent="1" source="c_Q" target="c_WA"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2226.3" y="593.4"/></Array></mxGeometry></mxCell><mxCell id="c_e_L_WA_NGX_0" value="webhook status &amp;amp; tombol (HMAC)" style="edgeStyle=none;curved=1;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;startArrow=none;" edge="1" parent="1" source="c_WA" target="c_NGX"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2226.3" y="634.9"/><mxPoint x="1981.8" y="634.9"/><mxPoint x="1733.3" y="634.9"/><mxPoint x="1509.8" y="634.9"/><mxPoint x="1264" y="634.9"/><mxPoint x="1040.7" y="634.9"/><mxPoint x="917.4" y="634.9"/><mxPoint x="736.8" y="634.9"/><mxPoint x="556.1" y="634.9"/><mxPoint x="531.1" y="634.9"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="hal-alur-pelayanan" name="02 Alur pelayanan pasien"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2520" pageHeight="1690" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="judul" value="&lt;font style=&quot;font-size:10px;letter-spacing:1px&quot;&gt;FLOWCHART&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:20px&quot;&gt;Alur pelayanan pasien&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#000000;strokeColor=none;fillColor=none;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="32" width="2431.6640625" height="44" as="geometry"/></mxCell><mxCell id="catatan" value="• Perjalanan pasien dari booking atau walk-in sampai obat diserahkan, termasuk validasi yang menahan penutupan pemeriksaan.&lt;br&gt;• Tiga kolom adalah tiga fase berurutan: fase 1 berakhir saat kunjungan dibuat (&lt;font face=&quot;Courier New&quot;&gt;menunggu&lt;/font&gt;), fase 2 dimulai saat pasien dipanggil dan berakhir di &lt;font face=&quot;Courier New&quot;&gt;menunggu_pembayaran&lt;/font&gt;, fase 3 dimulai di kasir.&lt;br&gt;• Kunjungan &lt;font face=&quot;Courier New&quot;&gt;menunggu&lt;/font&gt; boleh dibatalkan. Tagihan &lt;font face=&quot;Courier New&quot;&gt;belum_bayar&lt;/font&gt; bisa di-void, tagihan &lt;font face=&quot;Courier New&quot;&gt;lunas&lt;/font&gt; bisa direfund (izin &lt;font face=&quot;Courier New&quot;&gt;kasir.void&lt;/font&gt;).&lt;br&gt;• Penjualan produk atau paket tanpa kunjungan memakai tagihan mandiri: &lt;font face=&quot;Courier New&quot;&gt;tagihans.kunjungan_id&lt;/font&gt; kosong, &lt;font face=&quot;Courier New&quot;&gt;pasien_id&lt;/font&gt; diisi.&lt;br&gt;• Obat hanya diserahkan setelah tagihan lunas, dengan urutan poli, kasir, lalu farmasi." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#000000;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1100" height="112" as="geometry"/></mxCell><mxCell id="c_FASE3" value="3 · Pembayaran &amp;amp; pasca-layanan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;verticalAlign=top;align=center;fontStyle=1;fontSize=12;spacingTop=2;container=1;collapsible=0;dropTarget=1;" vertex="1" parent="1"><mxGeometry x="1631" y="508.2" width="832.7" height="837.9" as="geometry"/></mxCell><mxCell id="c_FASE2" value="2 · Pemeriksaan &amp;amp; RME" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;verticalAlign=top;align=center;fontStyle=1;fontSize=12;spacingTop=2;container=1;collapsible=0;dropTarget=1;" vertex="1" parent="1"><mxGeometry x="1153" y="232.4" width="428" height="1389.6" as="geometry"/></mxCell><mxCell id="c_FASE1" value="1 · Pendaftaran &amp;amp; check-in" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;verticalAlign=top;align=center;fontStyle=1;fontSize=12;spacingTop=2;container=1;collapsible=0;dropTarget=1;" vertex="1" parent="1"><mxGeometry x="48" y="218" width="1055" height="1418.4" as="geometry"/></mxCell><mxCell id="c_A" value="Pasien datang / menghubungi klinik" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c_FASE1"><mxGeometry x="246.4" y="37.5" width="243.5" height="33" as="geometry"/></mxCell><mxCell id="c_B" value="Sudah booking?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c_FASE1"><mxGeometry x="296.3" y="145.5" width="144.6" height="144.6" as="geometry"/></mxCell><mxCell id="c_BK" value="Booking · appointments&lt;br&gt;slot = durasi + buffer treatment&lt;br&gt;cek jadwal praktik, cuti, ruang &amp;amp; alat wajib&lt;br&gt;SIP dokter berlaku" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c_FASE1"><mxGeometry x="45.3" y="386.1" width="311.4" height="108" as="geometry"/></mxCell><mxCell id="c_WA1" value="Reminder WhatsApp H-1 &amp;amp; ±2 jam&lt;br&gt;tombol Konfirmasi / Ubah jadwal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c_FASE1"><mxGeometry x="69.1" y="598.9" width="264" height="66" as="geometry"/></mxCell><mxCell id="c_CI" value="Check-in → booking hadir" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c_FASE1"><mxGeometry x="56" y="811.6" width="207.4" height="45" as="geometry"/></mxCell><mxCell id="c_NS" value="Booking tidak_hadir&lt;br&gt;(no-show)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c_FASE1"><mxGeometry x="303.4" y="801.1" width="174" height="66" as="geometry"/></mxCell><mxCell id="c_P1" value="Pasien baru?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c_FASE1"><mxGeometry x="555.3" y="569.1" width="125.5" height="125.5" as="geometry"/></mxCell><mxCell id="c_P2" value="Daftar pasien&lt;br&gt;deteksi duplikat NIK / no HP / nama + tgl lahir&lt;br&gt;No. RM otomatis" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c_FASE1"><mxGeometry x="690.2" y="790.6" width="334.8" height="87" as="geometry"/></mxCell><mxCell id="c_P3" value="Cari pasien" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c_FASE1"><mxGeometry x="517.4" y="811.6" width="117.7" height="45" as="geometry"/></mxCell><mxCell id="c_PDP" value="Persetujuan UU PDP berlaku?&lt;br&gt;bila pdp.wajib_persetujuan aktif" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c_FASE1"><mxGeometry x="402.4" y="952.6" width="266.3" height="266.3" as="geometry"/></mxCell><mxCell id="c_PDP2" value="Tanda tangan persetujuan pemrosesan&lt;br&gt;+ opt-in marketing terpisah" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c_FASE1"><mxGeometry x="201.9" y="1314.9" width="292" height="66" as="geometry"/></mxCell><mxCell id="c_K1" value="Kunjungan dibuat · status menunggu&lt;br&gt;no. antrian per cabang · poli · hari" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c_FASE1"><mxGeometry x="747" y="1314.9" width="278" height="66" as="geometry"/></mxCell><mxCell id="c_K2" value="Panggil pasien → diperiksa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c_FASE2"><mxGeometry x="106.5" y="37.5" widt