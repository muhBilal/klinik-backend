<mxfile host="Lefaklinik AI-Context" modified="2026-10-02T02:29:57.681Z" agent="convert-drawio.mjs" version="24.0.0" type="device"><diagram id="hal-arsitektur" name="01 Arsitektur sistem"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2790" pageHeight="950" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="judul" value="&lt;font style=&quot;font-size:10px;letter-spacing:1px&quot;&gt;FLOWCHART&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:20px&quot;&gt;Arsitektur sistem&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#000000;strokeColor=none;fillColor=none;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="32" width="2705.609375" height="44" as="geometry"/></mxCell><mxCell id="catatan" value="• Jalur sebuah request dari SPA sampai database, plus pekerjaan latar belakang dan dua layanan luar.&lt;br&gt;• Satu instalasi melayani satu organisasi klinik dengan banyak cabang. Pasien milik pusat; kunjungan, resep, tagihan, stok, shift kas, booking, dan komisi milik satu cabang (trait &lt;font face=&quot;Courier New&quot;&gt;DalamCabang&lt;/font&gt;).&lt;br&gt;• Logika bisnis hanya di &lt;font face=&quot;Courier New&quot;&gt;app/Services/&lt;/font&gt;. Setiap perubahan model &lt;font face=&quot;Courier New&quot;&gt;Auditable&lt;/font&gt; tercatat ke &lt;font face=&quot;Courier New&quot;&gt;audit_logs&lt;/font&gt; yang append-only." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#000000;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1100" height="78" as="geometry"/></mxCell><mxCell id="c_Server" value="Container eklinik · Docker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;verticalAlign=top;align=center;fontStyle=1;fontSize=12;spacingTop=2;container=1;collapsible=0;dropTarget=1;" vertex="1" parent="1"><mxGeometry x="344.9" y="307.6" width="2238" height="384.5" as="geometry"/></mxCell><mxCell id="c_SPA" value="Vue 3 SPA&lt;br&gt;frontend/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="48" y="503.1" width="111.9" height="66" as="geometry"/></mxCell><mxCell id="c_DB" value="PostgreSQL 17" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2632.9" y="371.8" width="104.7" height="67.2" as="geometry"/></mxCell><mxCell id="c_FS" value="Disk berkas&lt;br&gt;terenkripsi APP_KEY" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1911.8" y="184" width="140.1" height="93.6" as="geometry"/></mxCell><mxCell id="c_SS" value="SATUSEHAT&lt;br&gt;Bundle FHIR R4 · OAuth2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2324.9" y="722.1" width="208" height="66" as="geometry"/></mxCell><mxCell id="c_WA" value="WhatsApp Cloud API&lt;br&gt;pesan template" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2339.4" y="828.1" width="178.9" height="66" as="geometry"/></mxCell><mxCell id="c_API" value="Laravel 13 REST API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;verticalAlign=top;align=center;fontStyle=1;fontSize=12;spacingTop=2;container=1;collapsible=0;dropTarget=1;" vertex="1" parent="c_Server"><mxGeometry x="211.2" y="20" width="2001.8" height="181.2" as="geometry"/></mxCell><mxCell id="c_NGX" value="Nginx&lt;br&gt;/ → build Vue&lt;br&gt;/api → Laravel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c_Server"><mxGeometry x="25" y="185" width="136.2" height="87" as="geometry"/></mxCell><mxCell id="c_Q" value="Queue worker&lt;br&gt;queue:work" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c_Server"><mxGeometry x="1568.9" y="231.2" width="136.1" height="66" as="geometry"/></mxCell><mxCell id="c_SCH" value="Scheduler&lt;br&gt;schedule:work" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c_Server"><mxGeometry x="1094.8" y="231.2" width="140.2" height="66" as="geometry"/></mxCell><mxCell id="c_MW" value="Middleware&lt;br&gt;auth:sanctum → cabang → wajib2fa → izin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c_API"><mxGeometry x="25" y="64.7" width="311.4" height="66" as="geometry"/></mxCell><mxCell id="c_CTRL" value="Controller&lt;br&gt;validasi input, query list" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c_API"><mxGeometry x="386.4" y="64.7" width="196.6" height="66" as="geometry"/></mxCell><mxCell id="c_SVC" value="Service&lt;br&gt;aturan bisnis + DB::transaction" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c_API"><mxGeometry x="832.9" y="64.7" width="241.6" height="66" as="geometry"/></mxCell><mxCell id="c_MDL" value="Model Eloquent&lt;br&gt;Auditable · DalamCabang · SoftDeletes"